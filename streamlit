import streamlit as st
from consumidor_api import obter_dados_meteorologicos

# Configuração da página conforme o modelo do professor
st.set_page_config(
    page_title="Monitoramento Meteorológico",
    page_icon="🌦️",
    layout="wide"
)

st.title("🌦️ Monitoramento Meteorológico")
st.caption("Estação meteorológica — Jaraguá do Sul/SC")
st.divider()

# Botão de atualização oficial do anexo
if st.button("🔄 Atualizar dados"):
    st.rerun()

try:
    with st.spinner("Consultando a API meteorológica..."):
        dados = obter_dados_meteorologicos()
        
    st.success("Dados meteorológicos carregados.")
    st.subheader("Condições atuais")
    
    # Organização em colunas idêntica ao modelo fornecido
    col1, col2, col3 = st.columns(3)
    
    col1.metric(
        "Temperatura",
        f"{dados['temperatura']} °C"
    )
    col2.metric(
        "Umidade Relativa",
        f"{dados['umidade_relativa']} %"
    )
    col3.metric(
        "Sensação Térmica",
        f"{dados['sensacao_termica']} °C"
    )
    
    col4, col5 = st.columns(2)
    col4.metric(
        "Precipitação",
        f"{dados['precipitacao']} mm"
    )
    col5.metric(
        "Velocidade do Vento",
        f"{dados['velocidade_vento']} km/h"
    )
    
    st.caption(f"🕒 Horário da medição: {dados['horario']}")

except Exception as erro:
    st.error(f"Erro ao conectar com a API: {erro}")
